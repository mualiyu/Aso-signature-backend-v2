APP_NAME="Aso Signature"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_DEBUG_ALLOWED_IPS=
APP_URL=https://aso-signature.test
APP_ADMIN_URL=admin
APP_TIMEZONE=Africa/Lagos
APP_LOCALE=en
APP_CURRENCY=USD

VITE_HOST=
VITE_PORT=

LOG_CHANNEL=stack

DB_CONNECTION="mysql"
DB_HOST="127.0.0.1"
DB_PORT="3306"
DB_DATABASE="aso_signature_db"
DB_USERNAME="root"
DB_PASSWORD=
DB_PREFIX=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
SESSION_DRIVER=file
SESSION_LIFETIME=120
QUEUE_DRIVER=sync

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

RESPONSE_CACHE_ENABLED=false

MAIL_MAILER=smtp
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls

MAIL_FROM_ADDRESS=hello@asosignature.com
MAIL_FROM_NAME="Aso Signature"

ADMIN_MAIL_ADDRESS=admin@example.com
ADMIN_MAIL_NAME=

FIXER_API_KEY=
EXCHANGE_RATES_API_KEY=
EXCHANGE_RATES_API_ENDPOINT=

# Exchange Rate API Provider (options: currencylayer, fixer, exchange_rates, flutterwave)
EXCHANGE_API_DEFAULT=currencylayer
CURRENCY_API_URL=https://apilayer.net/api/live
CURRENCY_API_KEY=
CURRENCY_BASE=USD
CURRENCY_SYMBOLS=USD,NGN,EUR,GBP

# Flutterwave Exchange Rate Configuration
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_SANDBOX=true

# Stripe (optional — payment keys are configured in Admin → Configuration → Sales → Payment Methods → Stripe)
STRIPE_KEY=
STRIPE_SECRET=

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1

MIX_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
MIX_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_CALLBACK_URL=https://yourhost.com/customer/social-login/facebook/callback

TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=
TWITTER_CALLBACK_URL=https://yourhost.com/customer/social-login/twitter/callback

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=https://yourhost.com/customer/social-login/google/callback

LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_CALLBACK_URL=https://yourhost.com/customer/social-login/linkedin-openid/callback

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=https://yourhost.com/customer/social-login/github/callback

SANCTUM_STATEFUL_DOMAINS=aso-signature.test

# Public storefront URL (used for "Visit Shop" and SEO previews in the admin)
STORE_FRONT_URL=https://aso-signature.test

# Aso Measurement Service (standalone Smart Measurement wizard)
MEASUREMENT_SERVICE_URL=
MEASUREMENT_SERVICE_SECRET=
MEASUREMENT_SERVICE_METHOD=auto
MEASUREMENT_SERVICE_TOKEN_TTL=600
MEASUREMENT_SERVICE_CALLBACK_TOLERANCE=300

# Laravel Nightwatch monitoring (optional; leave empty locally)
NIGHTWATCH_TOKEN=
